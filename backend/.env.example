MONGO_URL=mongodb://localhost:27017
DB_NAME=ielts
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Google Gemini API — https://ai.google.dev (Google AI Studio)
# Used for PDF exam extraction and Writing/Speaking AI evaluation.
# NOTE: on a free-tier (no billing enabled) Google Cloud project, "-pro" tier models
# currently have a 0 free-tier request quota and will always 429. "-flash" tier models
# (the default below) do have a working free allocation. Enable billing on the linked
# Google Cloud project to use pro-tier models or raise the flash-tier rate limits.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# Cloudinary — https://cloudinary.com (Dashboard > Account Details)
# Used for private storage of uploaded source PDFs.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
